<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:layoutDirection="rtl" android:padding="14dp"
    android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
        <ImageView android:layout_width="32dp" android:layout_height="32dp"
            android:src="@mipmap/ic_ayat" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:fontFamily="@font/cairo" android:text="@string/widget_title" android:textColor="@color/widget_primary"
            android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <ImageButton android:id="@+id/widget_refresh" android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/widget_refresh_background" android:src="@drawable/ic_widget_refresh"
            android:padding="10dp" android:contentDescription="@string/widget_refresh" />
    </LinearLayout>
    <TextView android:id="@+id/widget_reference" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="@font/cairo" android:text="@string/widget_default_reference" android:textColor="@color/widget_secondary"
        android:textSize="11sp" android:gravity="center" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_verse" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fontFamily="@font/kfgqpc" android:text="@string/widget_default_verse"
        android:gravity="center" android:textDirection="rtl" android:textColor="@color/widget_text" android:paddingVertical="6dp"
        android:textSize="26sp" android:maxLines="7" android:ellipsize="end"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/cairo"
        android:text="@string/widget_open" android:textColor="@color/widget_primary" android:textSize="11sp" android:gravity="center" />
</LinearLayout>
